datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Player {
  id      Int    @id @default(autoincrement())
  name    String @unique
  elo     Int    @default(1000)
  wins    Int    @default(0)
  losses  Int    @default(0)
}
model Expense {
  id        Int      @id @default(autoincrement())
  name      String
  payer     String
  amount    Float
  createdAt DateTime @default(now())
}
model Match {
  id        Int      @id @default(autoincrement())
  team1     String
  team2     String
  score1    Int
  score2    Int
  createdAt DateTime @default(now())
}